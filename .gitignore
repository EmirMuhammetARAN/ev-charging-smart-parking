# ============================================
# EV Şarj İstasyonu Akıllı Park Yönetimi
# .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
.venv/
env/

# Environment Variables (API KEYS!)
.env

# Datasets ve Test Çıktıları (büyük, git'e eklenmemeli)
datasets/
rain_test/
video_test/

# Model Ağırlıkları (büyük dosyalar)
*.pt
*.onnx
runs/

# Eğitim Sonuçları (büyük)
results/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs & Temp Files
*.log
test_sonuc.jpg
*.mp4
